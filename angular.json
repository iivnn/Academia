{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "cli": { "analytics": false },
  "projects": { "academia": { "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
    "architect": {
      "build": { "builder": "@angular/build:application", "options": { "browser": "src/main.ts", "tsConfig": "tsconfig.app.json", "assets": [{ "glob": "**/*", "input": "public" }], "styles": ["src/styles.scss"] },
        "configurations": { "production": { "serviceWorker": "ngsw-config.json", "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }] }, "development": { "optimization": false, "extractLicenses": false, "sourceMap": true } }, "defaultConfiguration": "production" },
      "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "academia:build:production" }, "development": { "buildTarget": "academia:build:development" } }, "defaultConfiguration": "development" }
    }
  } }
}
